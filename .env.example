# Copie este arquivo para ".env" e ajuste os valores conforme sua máquina.
# Nenhuma informação aqui é secreta neste projeto, mas mantemos a
# configuração separada do código para facilitar mudanças futuras.

# --------------------------------------------------------------------
# Aplicativos e pastas
# --------------------------------------------------------------------
ANTIGRAVITY_PATH=C:\Users\joaoc\Desktop\Antigravity IDE.lnk
VSCODE_PATH=C:\Users\joaoc\Desktop\Visual Studio Code.lnk

FRONTEND_PATH=C:\Users\joaoc\Desktop\Matéria - Front-end
BACKEND_PATH=C:\Users\joaoc\Desktop\Matéria - Back-end

# --------------------------------------------------------------------
# URLs
# --------------------------------------------------------------------
CHATGPT_URL=https://chatgpt.com/
FRONTEND_GITHUB_URL=https://github.com/JCReis12/frontend-knowledge-base
BACKEND_GITHUB_URL=https://github.com/JCReis12/backend-knowledge-base

# --------------------------------------------------------------------
# Microsoft Edge
# --------------------------------------------------------------------
EDGE_PROFILE=Default
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# --------------------------------------------------------------------
# Som de ativação
# --------------------------------------------------------------------
ACTIVATION_SOUND=assets/activation.wav

# --------------------------------------------------------------------
# Voz (Text-to-Speech)
# --------------------------------------------------------------------
# Palavra-chave para localizar uma voz masculina instalada no Windows.
TTS_VOICE_KEYWORD=Daniel
TTS_RATE=175

# --------------------------------------------------------------------
# Reconhecimento de voz offline (Vosk)
# --------------------------------------------------------------------
VOSK_MODEL_PATH=models/vosk-model-pt-fb-v0.1.1-20220516_2113
WAKE_WORD=myles,mails,miles,maiuls,my less
